d filetype-1.2.0 google-auth-2.57.0 google-genai-2.22.0 langchain-core-1.6.1 langchain-google-genai-4.4.0\n"]},{"output_type":"display_data","data":{"application/vnd.colab-display-data+json":{"pip_warning":{"packages":["google"]},"id":"b14e1e1807e24311b9f9dae80a11428c"}},"metadata":{}}]},{"cell_type":"code","execution_count":2,"metadata":{"id":"MPBWlPHG48-H","executionInfo":{"status":"ok","timestamp":1788409752743,"user_tz":420,"elapsed":3706,"user":{"displayName":"Aditya Dakua","userId":"15747019751700973689"}},"colab":{"base_uri":"https://localhost:8080/"},"outputId":"0a111db1-a94b-408d-fda5-0c43cdb77e5b"},"outputs":[{"output_type":"stream","name":"stderr","text":["/usr/local/lib/python3.13/dist-packages/google/colab/_import_hooks/_hook_injector.py:55: FutureWarning: \n","\n","All support for the `google.generativeai` package has ended. It will no longer be receiving \n","updates or bug fixes. Please switch to the `google.genai` package as soon as possible.\n","See README for more details:\n","\n","https://github.com/google-gemini/deprecated-generative-ai-python/blob/main/README.md\n","\n","  loader.exec_module(module)\n"]}],"source":["from google.colab import userdata\n","key=userdata.get('Adi')\n","import google.generativeai as genai\n","genai.configure(api_key=key)"]},{"cell_type":"code","source":["from google.colab import userdata\n","from langchain_google_genai import ChatGoogleGenerativeAI\n","\n","# 1. Setup model with your secret key\n","llm = ChatGoogleGenerativeAI(\n","    model=\"gemini-3.5-flash-lite\",\n","    google_api_key=userdata.get('Adi')\n",")\n","\n","# 2. Simple list to track context\n","messages = []\n","\n","print(\"Chatbot ready! Type 'exit' to quit.\\n\")\n","\n","# 3. Chat loop\n","while True:\n","    user_input = input(\"You: \")\n","    if user_input.lower() == \"exit\":\n","        break\n","\n","    # Add user message as a tuple: (\"user\", \"text\")\n","    messages.append((\"user\", user_input))\n","\n","    # Send conversation history to model\n","    response = llm.invoke(messages)\n","\n","    # Add AI response to history as a tuple: (\"assistant\", \"text\")\n","    messages.append((\"assistant\", response.content))\n","\n","    # Print response\n","    print(f\"Bot: {response.content}\\n\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"BYHbB9SErAly","outputId":"373ba9c2-bebe-4170-e7d0-5bef24cfcc16"},"execution_count":null,"outputs":[{"name":"stdout","output_type":"stream","text":["Chatbot ready! Type 'exit' to quit.\n","\n","You: what are the codd's rules of database management systems\n"]},{"output_type":"stream","name":"stderr","text":["WARNING:google_genai.models:Direct use of automatic function calling (AFC) in Models.generate_content is not recommended. Instead, we recommend to use AFC in Chat.send_message. Similarly, direct use of AFC in Models.generate_content_stream is not recommended. Instead, we recommend to use AFC in Chat.send_message_stream.\n"]},{"output_type":"stream","name":"stdout","text":["Bot: [{'type': 'text', 'text': \"**Codd’s 12 Rules** (often referred to as Codd's 13 Rules, since they start at Rule 0) are a set of 13 axioms and rules proposed by **Edgar F. Codd**, a computer scientist who invented the relational model for database management. \\n\\nPublished in 1985, these rules were designed to define what it takes for a Database Management System (DBMS) to be considered **truly relational**. \\n\\nWhile few commercial relational databases strictly satisfy all 13 rules today, they remain the foundational benchmark for relational database design. Here is the breakdown:\\n\\n---\\n\\n### **Rule 0: The Foundation Rule**\\n> *For any system that is advertised as, or claimed to be, a relational database management system, that system must be able to manage databases entirely through its relational capabilities.*\\n* **Meaning:** If a database claims to be relational, it must use its relational facilities *only* to store and manipulate data.\\n\\n---\\n\\n### **Rule 1: The Information Rule**\\n> *All information in a relational database is represented explicitly at the logical level and in exactly one way—by values in tables.*\\n* **Meaning:** Everything in a relational database—including table names, column names, and metadata—must be stored in tables as data values. There are no hidden pointers or links outside of the data tables.\\n\\n---\\n\\n### **Rule 2: The Guaranteed Access Rule**\\n> *Each and every atomic (indivisible) datum (value) in a relational database is guaranteed to be logically accessible by resorting to a combination of table name, primary key value, and column name.*\\n* **Meaning:** Every single piece of data can be uniquely and definitively retrieved using three things: the table name, the column name, and the primary key of the row.\\n\\n---\\n\\n### **Rule 3: Systematic Treatment of Null Values**\\n> *Null values (distinct from the empty character string or a string of blank characters and distinct from zero or any other number) are supported in the fully relational DBMS for representing missing information and inapplicable information in a systematic way.*\\n* **Meaning:** The database must support `NULL` values to represent missing or unknown data, and it must handle them uniformly and systematically across all operations.\\n\\n---\\n\\n### **Rule 4: Active Online Catalog Based on the Relational Model**\\n> *The database description is represented at the logical level in the same way as ordinary data, so that authorized users can apply the same relational language to its interrogation as they apply to the regular data.*\\n* **Meaning:** The database metadata (the data dictionary or system catalog that describes the database structure) must be stored in regular tables, meaning users can query the database schema using standard SQL.\\n\\n---\\n\\n### **Rule 5: The Comprehensive Data Sublanguage Rule**\\n> *A relational system may support several languages and various modes of terminal use (e.g., query-by-example). However, there must be at least one language whose statements are expressible, by means of some preferred syntax, per character as strings and whose ability to support all of the following is comprehensive:*\\n> * *Data definition (DDL)*\\n> * *View definition (Views)*\\n> * *Data manipulation (DML - insert, update, delete)*\\n> * *Transaction boundaries (commit, rollback)*\\n> * *Security and integrity constraints*\\n* **Meaning:** The system must support at least one comprehensive language (like SQL) that can perform all database functions: defining data, querying data, updating data, setting security rules, and managing transactions.\\n\\n---\\n\\n### **Rule 6: The View Updating Rule**\\n> *All views that are theoretically updatable are also updatable by the system.*\\n* **Meaning:** If a virtual table (view) can logically be updated, the DBMS must allow users to perform insert, update, and delete operations on it directly.\\n\\n---\\n\\n### **Rule 7: High-Level Insert, Update, and Delete**\\n> *The capability of handling a base relation or a derived relation as a single operand applies not only to the retrieval of data but also to the insertion, updation, and deletion of data.*\\n* **Meaning:** The DBMS must support set-level operations. You should be able to insert, update, or delete multiple rows across multiple tables in a single command, rather than processing data one row at a time.\\n\\n---\\n\\n### **Rule 8: Physical Data Independence**\\n> *Application programs and terminal activities remain logically unimpaired regardless of any changes that are made in storage representations or access methods.*\\n* **Meaning:** Changes to the physical storage structure (like moving files to a new hard drive, adding indexes, or changing storage formats) should not require changes to application programs or queries.\\n\\n---\\n\\n### **Rule 9: Logical Data Independence**\\n> *Application programs and terminal activities remain logically unimpaired when information-preserving changes of any kind are made to the base tables.*\\n* **Meaning:** If the logical structure of the database changes (e.g., splitting a table into two, or adding a new column), existing applications and queries should continue to work without breaking.\\n\\n---\\n\\n### **Rule 10: Integrity Independence**\\n> *Integrity constraints specific to a relational database must be definable in the relational data sublanguage and storable in the catalog, not in the application programs.*\\n* **Meaning:** Business rules and constraints (like foreign keys, primary keys, and check constraints) must be enforced by the database itself, not by the external applications interacting with it.\\n\\n---\\n\\n### **Rule 11: Distribution Independence**\\n> *The distribution-independent DBMS has transparency to whether a database is distributed across multiple locations.*\\n* **Meaning:** The database should work the same way whether it is stored on a single local computer or distributed across a network of computers. If the database is split or moved across servers, applications shouldn't need to be rewritten.\\n\\n---\\n\\n### **Rule 12: The Non-Subversion Rule**\\n> *If a relational system has a low-level (record-at-a-time) language, that low-level language cannot be used to subvert or bypass the integrity rules or constraints expressed in the higher-level relational language (e.g., SQL).*\\n* **Meaning:** You cannot bypass the database's security and integrity rules by using low-level, record-by-record programming interfaces. The relational rules must always be enforced.\", 'extras': {'signature': 'El4KXAERTTIPIfQHOiO8/asha5ykU355xBvI9BoOn1wALPnH5xR1LR40PvpTIxxczmTpmhrSDYBhBk1tESV/PSsUVKVD+YjbZwyKmJm5oQ3ON2vNpimwfmgzV0LL+rc8'}}]\n","\n"]}]}]}